<Window x:Class="El3Almey.Wpf.Views.PlaylistLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video or playlist?" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0B1428" Foreground="#EAF1FF" FontFamily="Segoe UI" FontSize="14">
  <Border Margin="1" Padding="24" Background="#0F1B38" BorderBrush="#2F5D94" BorderThickness="1" CornerRadius="14">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
        <Border Width="46" Height="46" CornerRadius="12" Background="#19345E">
          <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#76B0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="HeadingText" Text="Video or playlist?" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubheadingText" Text="This video belongs to a playlist." Foreground="#9AABCA" Margin="0,4,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border Background="#111F3D" BorderBrush="#263A60" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,18">
        <TextBlock x:Name="PlaylistTitleText" TextWrapping="Wrap" FontWeight="SemiBold"/>
      </Border>
      <Button x:Name="PlaylistButton" Height="46" Click="PlaylistButton_Click" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,10">
        <Button.Style><Style TargetType="Button">
          <Setter Property="Background" Value="#2468C9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3479D8"/><Setter Property="BorderThickness" Value="1"/>
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2D74D8"/><Setter Property="BorderBrush" Value="#5590E5"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1A4F9C"/></Trigger>
          </Style.Triggers>
        </Style></Button.Style>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
          <TextBlock x:Name="PlaylistButtonText" Text="Download full playlist"/>
        </StackPanel>
      </Button>
      <Button x:Name="VideoButton" Height="44" Click="VideoButton_Click" Cursor="Hand" Margin="0,0,0,10">
        <Button.Style><Style TargetType="Button">
          <Setter Property="Background" Value="#192A49"/><Setter Property="Foreground" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#31476D"/><Setter Property="BorderThickness" Value="1"/>
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#213758"/><Setter Property="BorderBrush" Value="#4B76AD"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#12203A"/></Trigger>
          </Style.Triggers>
        </Style></Button.Style>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
          <TextBlock x:Name="VideoButtonText" Text="Download only this video"/>
        </StackPanel>
      </Button>
      <Button x:Name="CancelButton" Height="40" Click="CancelButton_Click" Cursor="Hand">
        <Button.Style><Style TargetType="Button">
          <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#9AABCA"/><Setter Property="BorderThickness" Value="0"/>
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#1B2D4D"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="#76B0FF"/></Trigger>
          </Style.Triggers>
        </Style></Button.Style>
        <TextBlock x:Name="CancelButtonText" Text="Cancel"/>
      </Button>
    </StackPanel>
  </Border>
</Window>