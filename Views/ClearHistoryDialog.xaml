<Window x:Class="El3Almey.Wpf.Views.ClearHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clear history" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0B1428" Foreground="#EAF1FF" FontFamily="Segoe UI" FontSize="14">
  <Border Margin="1" Padding="24" Background="#0F1B38" BorderBrush="#263A60" BorderThickness="1" CornerRadius="14">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
        <Border Width="46" Height="46" CornerRadius="12" Background="#431A25">
          <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#FF6978" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="HeadingText" Text="Clear download history?" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubheadingText" Text="This only removes entries from history." Foreground="#9AABCA" Margin="0,4,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border Background="#111F3D" BorderBrush="#263A60" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,18">
        <TextBlock x:Name="MessageText" Text="Downloaded files will not be deleted." TextWrapping="Wrap"/>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" Width="110" Height="40" Margin="0,0,10,0" Click="CancelButton_Click" Background="#192A49" Foreground="#EAF1FF" BorderBrush="#31476D" BorderThickness="1" Cursor="Hand"/>
        <Button x:Name="ConfirmButton" Content="Clear history" Width="130" Height="40" Click="ConfirmButton_Click" Background="#C43D50" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>