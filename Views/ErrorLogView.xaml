<UserControl x:Class="El3Almey.Wpf.Views.ErrorLogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="Transparent">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="Background" Value="#17366B"/>
   <Setter Property="BorderBrush" Value="#315B9A"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="Background" Value="#101F3A"/>
   <Setter Property="BorderBrush" Value="#2B4772"/>
   <Setter Property="CaretBrush" Value="#FFFFFF"/>
   <Setter Property="Padding" Value="10,8"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <StackPanel>
    <TextBlock Text="Error Center" FontSize="27" FontWeight="Bold" Foreground="#F3F7FF"/>
    <TextBlock Text="View and manage application logs, download failures and crash reports." FontSize="13" Foreground="#91A9CF" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="Open Log Folder" Click="OpenFolder_Click" Margin="0,0,8,0" Background="#14294C"/>
    <Button Content="⟳  Refresh" Click="Refresh_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#111F3C" BorderBrush="#263F6B" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,10,0">
    <StackPanel Orientation="Horizontal">
     <Border Width="42" Height="42" CornerRadius="21" Background="#43223E" VerticalAlignment="Center"><TextBlock Text="!" Foreground="#FF647F" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Total Errors" Foreground="#A7B9D5" FontSize="11"/><TextBlock x:Name="CountText" Text="0" Foreground="#FFFFFF" FontSize="25" FontWeight="Bold"/></StackPanel>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" Background="#111F3C" BorderBrush="#263F6B" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,10,0">
    <StackPanel Orientation="Horizontal">
     <Border Width="42" Height="42" CornerRadius="21" Background="#123B70" VerticalAlignment="Center"><TextBlock Text="↓" Foreground="#26A8FF" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Download Errors" Foreground="#A7B9D5" FontSize="11"/><TextBlock x:Name="DownloadCountText" Text="0" Foreground="#FFFFFF" FontSize="25" FontWeight="Bold"/></StackPanel>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Background="#111F3C" BorderBrush="#263F6B" BorderThickness="1" CornerRadius="11" Padding="15">
    <StackPanel Orientation="Horizontal">
     <Border Width="42" Height="42" CornerRadius="21" Background="#33245F" VerticalAlignment="Center"><TextBlock Text="⚙" Foreground="#B78AFF" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Crash Reports" Foreground="#A7B9D5" FontSize="11"/><TextBlock x:Name="CrashCountText" Text="0" Foreground="#FFFFFF" FontSize="25" FontWeight="Bold"/></StackPanel>
    </StackPanel>
   </Border>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.38*"/></Grid.ColumnDefinitions>
   <Border Background="#0D1930" BorderBrush="#263F6B" BorderThickness="1" CornerRadius="12" Padding="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="ISSUES &amp; EVENTS" Foreground="#8FB7EE" FontSize="11" FontWeight="Bold" Margin="3,2,0,12"/>
     <Grid Grid.Row="1" Margin="0,0,0,9">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="FilterBox" Height="36" TextChanged="FilterBox_TextChanged" VerticalContentAlignment="Center"/>
      <TextBlock Text="⌕" Grid.Column="1" Foreground="#72AFFF" FontSize="20" VerticalAlignment="Center" Margin="-30,0,10,0" IsHitTestVisible="False"/>
     </Grid>
     <ListBox x:Name="EntriesList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="EntriesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate>
       <Border Background="#122440" BorderBrush="#29466F" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,8">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="27" Height="27" CornerRadius="14" Background="#3B203D" VerticalAlignment="Top"><TextBlock Text="!" Foreground="#FF637E" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <StackPanel Grid.Column="1">
          <DockPanel LastChildFill="True"><TextBlock Text="{Binding TimeText}" Foreground="#8FA8CC" FontSize="10" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBlock Text="{Binding Title}" Foreground="#F1F6FF" FontSize="12" FontWeight="SemiBold"/></DockPanel>
          <TextBlock Text="{Binding Summary}" Foreground="#B5C6E0" FontSize="11" TextWrapping="Wrap" MaxHeight="38" Margin="0,5,0,0"/>
          <TextBlock Text="{Binding SourceName}" Foreground="#75B4FF" FontSize="10" Margin="0,6,0,0"/>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="#0D1930" BorderBrush="#263F6B" BorderThickness="1" CornerRadius="12" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
      <StackPanel><TextBlock Text="ERROR DETAILS" Foreground="#8FB7EE" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="DetailTitle" Text="Select an entry" Foreground="#F3F7FF" FontSize="20" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="DetailMeta" Text="Choose an issue from the list to inspect its details." Foreground="#91A9CF" FontSize="11" Margin="0,4,0,12"/></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#40233A" BorderBrush="#85415C" BorderThickness="1" CornerRadius="15" Padding="10,5"><TextBlock Text="●  ISSUE" Foreground="#FF8299" FontSize="10" FontWeight="Bold"/></Border>
     </Grid>
     <Border Grid.Row="1" Background="#102B53" BorderBrush="#1764B8" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,12">
      <StackPanel><TextBlock Text="SUGGESTED ACTION / WHAT HAPPENED" Foreground="#38B8FF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FriendlyReason" Text="No entry selected." Foreground="#E0ECFF" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
     </Border>
     <Expander Grid.Row="2" IsExpanded="True" Foreground="#DCE8FA" Background="#09162B" BorderBrush="#29466F" BorderThickness="1" Padding="0">
      <Expander.Header><DockPanel><TextBlock Text="Technical Details" FontWeight="SemiBold" Foreground="#EAF2FF"/><Button Content="Copy Details" Click="Copy_Click" DockPanel.Dock="Right" Padding="9,4" Margin="12,0,0,0"/></DockPanel></Expander.Header>
      <TextBox x:Name="RawDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#071326" Foreground="#C8D7ED" BorderBrush="#263A5B" Padding="12" FontFamily="Consolas" FontSize="11" MinHeight="170"/>
     </Expander>
     <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock x:Name="SourcePathText" Text="" Foreground="#8196B6" FontSize="10" VerticalAlignment="Center" MaxWidth="450" TextTrimming="CharacterEllipsis"/>
      <Button Content="Open Source Log" Click="OpenLog_Click" DockPanel.Dock="Right" Background="#172D52"/>
     </DockPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>