<UserControl x:Class="El3Almey.Wpf.Views.ErrorLogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="Transparent">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <StackPanel>
    <TextBlock Text="Error Center" FontSize="26" FontWeight="Bold" Foreground="#F2F6FF"/>
    <TextBlock Text="A readable view of application logs, download failures and crash reports." FontSize="13" Foreground="#91A4C4" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="↻  Refresh" Click="Refresh_Click" Padding="14,9" Margin="0,0,8,0" Background="#1B3765" Foreground="White" BorderBrush="#31598C"/>
    <Button Content="Open log folder" Click="OpenFolder_Click" Padding="14,9" Background="#172743" Foreground="#DCE8FF" BorderBrush="#304462"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
   <Border Background="#101D36" BorderBrush="#263A5B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="●" Foreground="#FF687B" FontSize="17" Margin="0,0,9,0"/>
     <StackPanel><TextBlock Text="Log entries" Foreground="#91A4C4" FontSize="11"/><TextBlock x:Name="CountText" Text="0" Foreground="#F2F6FF" FontSize="20" FontWeight="Bold"/></StackPanel>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" Background="#101D36" BorderBrush="#263A5B" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,10,0">
    <StackPanel><TextBlock Text="Log files" Foreground="#91A4C4" FontSize="11"/><TextBlock x:Name="FilesText" Text="0" Foreground="#F2F6FF" FontSize="20" FontWeight="Bold"/></StackPanel>
   </Border>
   <Border Grid.Column="2" Background="#101D36" BorderBrush="#263A5B" BorderThickness="1" CornerRadius="10" Padding="12,10">
    <StackPanel><TextBlock Text="Latest entry" Foreground="#91A4C4" FontSize="11"/><TextBlock x:Name="LatestText" Text="—" Foreground="#F2F6FF" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
   </Border>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#0D1930" BorderBrush="#263A5B" BorderThickness="1" CornerRadius="12" Padding="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="ISSUES &amp; EVENTS" Foreground="#8FA6CB" FontSize="11" FontWeight="Bold" Margin="3,2,0,12"/>
     <TextBox x:Name="FilterBox" Grid.Row="1" Height="36" Padding="10,7" Background="#142440" Foreground="#EAF1FF" BorderBrush="#304666" BorderThickness="1" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged"/>
     <ListBox x:Name="EntriesList" Grid.Row="2" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="EntriesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate>
       <Border Background="#142440" BorderBrush="#2A3F61" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
        <StackPanel>
         <DockPanel><TextBlock Text="{Binding SourceName}" Foreground="#83B8FF" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding TimeText}" Foreground="#8FA2C0" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
         <TextBlock Text="{Binding Title}" Foreground="#F1F5FF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,3"/>
         <TextBlock Text="{Binding Summary}" Foreground="#A9B9D2" FontSize="11" TextWrapping="Wrap" MaxHeight="42"/>
        </StackPanel>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="#0D1930" BorderBrush="#263A5B" BorderThickness="1" CornerRadius="12" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="ERROR DETAILS" Foreground="#8FA6CB" FontSize="11" FontWeight="Bold"/>
      <TextBlock x:Name="DetailTitle" Text="Select an entry" Foreground="#F1F5FF" FontSize="19" FontWeight="Bold" Margin="0,8,0,0"/>
      <TextBlock x:Name="DetailMeta" Text="Choose an issue from the list to inspect its details." Foreground="#8FA2C0" FontSize="11" Margin="0,5,0,12"/>
     </StackPanel>
     <Border Grid.Row="1" Background="#142440" BorderBrush="#2A3F61" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
      <StackPanel><TextBlock Text="WHAT HAPPENED" Foreground="#83B8FF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FriendlyReason" Text="No entry selected." Foreground="#DCE7F8" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <TextBox x:Name="RawDetails" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#081326" Foreground="#C8D7ED" BorderBrush="#263A5B" Padding="12" FontFamily="Consolas" FontSize="11"/>
     <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock x:Name="SourcePathText" Text="" Foreground="#8196B6" FontSize="10" VerticalAlignment="Center" MaxWidth="430" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <Button Content="Copy details" Click="Copy_Click" Padding="13,8" Margin="8,0,0,0" Background="#1B3765" Foreground="White" BorderBrush="#31598C"/>
       <Button Content="Open source log" Click="OpenLog_Click" Padding="13,8" Margin="8,0,0,0" Background="#172743" Foreground="#DCE8FF" BorderBrush="#304462"/>
      </StackPanel>
     </DockPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>