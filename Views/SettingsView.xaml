<UserControl x:Class="El3Almey.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight">
  <UserControl.Resources>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="SectionSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SettingToggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid MinHeight="42">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Border x:Name="Track" Grid.Column="1" Width="42" Height="24" CornerRadius="12"
                      Background="#263654" BorderBrush="#3A4F70" BorderThickness="1"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#A9B8D2"
                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Primary}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Primary}"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinWidth" Value="150"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Margin="0,0,12,10">
      <!-- Page heading -->
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{DynamicResource S.Settings}" FontSize="29" FontWeight="Bold"/>
          <TextBlock Text="Personalize how your downloads are saved and managed."
                     FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#142B50" BorderBrush="#244B83" BorderThickness="1"
                CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="#68A8FF" FontSize="18" Margin="0,0,9,0"/>
            <TextBlock Text="APP PREFERENCES" Foreground="#B9D5FF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- General -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#183D75" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="#80B7FF" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{DynamicResource S.General}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Language and default save location" Style="{StaticResource SectionSubtitle}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource S.Language}" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Style="{StaticResource SettingCombo}"/>
                <TextBlock Text="{DynamicResource S.LanguageDesc}" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource S.DownloadFolder}" Style="{StaticResource Label}"/>
                <Grid Height="46">
                  <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"/>
                  <Grid Margin="7,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="16" Foreground="{StaticResource TextMuted}"/>
                    <TextBox Grid.Column="1" Text="{Binding DownloadFolder, UpdateSourceTrigger=LostFocus}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}"
                             CaretBrush="White" FontSize="12" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
                    <Button Grid.Column="2" Command="{Binding BrowseFolderCommand}" Style="{StaticResource BtnBase}"
                            Background="#1A3155" Padding="13,0" Margin="2">
                      <TextBlock Text="{DynamicResource S.Browse}" FontSize="12"/>
                    </Button>
                  </Grid>
                </Grid>
                <TextBlock Text="{DynamicResource S.AudioDownloadFolder}" Style="{StaticResource Label}" Margin="0,12,0,0"/>
                <Grid Height="46">
                  <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"/>
                  <Grid Margin="7,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="16" Foreground="{StaticResource TextMuted}"/>
                    <TextBox Grid.Column="1" Text="{Binding AudioDownloadFolder, UpdateSourceTrigger=LostFocus}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}"
                             CaretBrush="White" FontSize="12" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
                    <Button Grid.Column="2" Command="{Binding BrowseAudioFolderCommand}" Style="{StaticResource BtnBase}"
                            Background="#1A3155" Padding="13,0" Margin="2">
                      <TextBlock Text="{DynamicResource S.Browse}" FontSize="12"/>
                    </Button>
                  </Grid>
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Defaults -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#153C35" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Foreground="#64DDB4" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{DynamicResource S.Defaults}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Choose the starting format and quality for new downloads." Style="{StaticResource SectionSubtitle}"/>
            <TextBlock Text="{DynamicResource S.DefaultType}" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <RadioButton GroupName="dt" Style="{StaticResource Chip}" IsChecked="{Binding DefaultIsVideo, Mode=TwoWay}" Content="{DynamicResource S.Video}"/>
              <RadioButton GroupName="dt" Style="{StaticResource Chip}" IsChecked="{Binding DefaultIsAudio, Mode=TwoWay}" Content="{DynamicResource S.Audio}"/>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource S.DefaultVideoQ}" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding VideoChoices}" SelectedItem="{Binding DefaultVideo}" Style="{StaticResource SettingCombo}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource S.DefaultAudioQ}" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding AudioChoices}" SelectedItem="{Binding DefaultAudio}" Style="{StaticResource SettingCombo}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Video options -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#183D75" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" Foreground="#80B7FF" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Video options" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Default options applied to individual video downloads." Style="{StaticResource SectionSubtitle}"/>
            <CheckBox Style="{StaticResource SettingToggle}" IsChecked="{Binding IncludeChaptersByDefault}">
              <StackPanel>
                <TextBlock Text="Embed YouTube chapters by default" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Start with chapter embedding enabled for single-video downloads. You can change it for each download." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Playlist behavior -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#3B2D5E" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="#C5A7FF" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{DynamicResource S.Playlists}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Keep playlist downloads organized automatically." Style="{StaticResource SectionSubtitle}"/>
            <Border Background="#0B1630" CornerRadius="10" Padding="12,4">
              <StackPanel>
                <CheckBox Style="{StaticResource SettingToggle}" IsChecked="{Binding CreateSubfolder}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource S.PlaylistSubDefault}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="Save each playlist in its own folder." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                  </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,4"/>
                <CheckBox Style="{StaticResource SettingToggle}" IsChecked="{Binding NumberItems}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource S.NumberDefault}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="Prefix filenames with their playlist order." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Download queue -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#4A321C" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="#FFC16D" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{DynamicResource S.DownloadsSection}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Control queue speed and automatic processing." Style="{StaticResource SectionSubtitle}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="{DynamicResource S.MaxConcurrent}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="How many items may download at once." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding ConcurrentChoices}" SelectedItem="{Binding MaxConcurrent}"
                        Style="{StaticResource SettingCombo}" HorizontalAlignment="Stretch"/>
            </Grid>
            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,14,0,10"/>
            <CheckBox Style="{StaticResource SettingToggle}" IsChecked="{Binding AutoStart}">
              <StackPanel>
                <TextBlock Text="{DynamicResource S.AutoStart}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Start the next queued item when a slot becomes available." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
            </CheckBox>
            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,8,0,10"/>
            <CheckBox Style="{StaticResource SettingToggle}" IsChecked="{Binding ShowDownloadCompletedNotification}">
              <StackPanel>
                <TextBlock Text="{DynamicResource S.DownloadCompletedNotification}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource S.DownloadCompletedNotificationDesc}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>
            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,4,0,10"/>
            <CheckBox Style="{StaticResource SettingToggle}" IsChecked="{Binding PlaySoundNotification}">
              <StackPanel>
                <TextBlock Text="{DynamicResource S.PlaySoundNotification}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource S.PlaySoundNotificationDesc}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>
            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,4,0,10"/>
            <CheckBox Style="{StaticResource SettingToggle}" IsChecked="{Binding SleepWhenDownloadsFinish}">
              <StackPanel>
                <TextBlock Text="{DynamicResource S.SleepWhenDownloadsFinish}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource S.SleepWhenDownloadsFinishDesc}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Grid>
      </Border>


      <!-- Advanced download behavior (visual design only; not wired yet) -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#4A321C" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="#FFC16D" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <DockPanel LastChildFill="False">
              <StackPanel>
                <TextBlock Text="Advanced download behavior" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Fine-tune speed, retries and how the queue handles existing files." Style="{StaticResource SectionSubtitle}"/>
              </StackPanel>
              <Border Background="#26344D" CornerRadius="8" Padding="9,5" VerticalAlignment="Top">
                <TextBlock Text="COMING LATER" FontSize="9" FontWeight="Bold" Foreground="#B8C8E2"/>
              </Border>
            </DockPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Maximum download speed" Style="{StaticResource Label}"/>
                <ComboBox IsEnabled="False" Style="{StaticResource SettingCombo}" SelectedIndex="0">
                  <ComboBoxItem Content="Unlimited"/><ComboBoxItem Content="1 MB/s"/><ComboBoxItem Content="2 MB/s"/><ComboBoxItem Content="5 MB/s"/><ComboBoxItem Content="10 MB/s"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Automatic retry count" Style="{StaticResource Label}"/>
                <ComboBox IsEnabled="False" Style="{StaticResource SettingCombo}" SelectedIndex="2">
                  <ComboBoxItem Content="Never"/><ComboBoxItem Content="1 retry"/><ComboBoxItem Content="3 retries"/><ComboBoxItem Content="5 retries"/>
                </ComboBox>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,14,0,8"/>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False">
              <StackPanel><TextBlock Text="Automatically retry failed downloads" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Retry temporary network and server errors." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            </CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False">
              <StackPanel><TextBlock Text="Resume unfinished downloads on startup" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Continue interrupted items when the app opens again." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            </CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False">
              <StackPanel><TextBlock Text="Ask before replacing an existing file" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Choose whether to overwrite, rename or skip duplicate files." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            </CheckBox>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Media and metadata -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#183B4D" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" Foreground="#75D8F5" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <DockPanel LastChildFill="False">
              <StackPanel><TextBlock Text="Media, subtitles &amp; metadata" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose what information and artwork is stored inside downloaded files." Style="{StaticResource SectionSubtitle}"/></StackPanel>
              <Border Background="#26344D" CornerRadius="8" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="COMING LATER" FontSize="9" FontWeight="Bold" Foreground="#B8C8E2"/></Border>
            </DockPanel>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Embed video thumbnail" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Save the YouTube thumbnail inside the downloaded media file." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Embed video metadata" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Include title, uploader, description and upload date when supported." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Download subtitles automatically" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Download available manual and auto-generated subtitles." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <TextBlock Text="Preferred subtitle languages" Style="{StaticResource Label}" Margin="0,10,0,6"/>
            <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Opacity="0.55">
              <TextBlock Text="English, Arabic  ·  Select languages (coming later)" FontSize="12" Foreground="{StaticResource TextMuted}"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Playlist, channel and search organization -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#3B2D5E" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="#C5A7FF" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <DockPanel LastChildFill="False">
              <StackPanel><TextBlock Text="Playlists, channels &amp; search" Style="{StaticResource SectionTitle}"/><TextBlock Text="Keep multi-video downloads consistently named and organized." Style="{StaticResource SectionSubtitle}"/></StackPanel>
              <Border Background="#26344D" CornerRadius="8" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="COMING LATER" FontSize="9" FontWeight="Bold" Foreground="#B8C8E2"/></Border>
            </DockPanel>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Number files in playlists, channels and search results" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Prefix filenames with their original item order." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Skip duplicate videos automatically" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Avoid adding the same video more than once to the queue or results." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Create an M3U playlist file" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Generate a media playlist alongside downloaded playlist files." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Notifications -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#49304C" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Foreground="#E5A8F0" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <DockPanel LastChildFill="False">
              <StackPanel><TextBlock Text="Notifications" Style="{StaticResource SectionTitle}"/><TextBlock Text="Decide when the app should alert you." Style="{StaticResource SectionSubtitle}"/></StackPanel>
              <Border Background="#26344D" CornerRadius="8" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="MORE OPTIONS LATER" FontSize="9" FontWeight="Bold" Foreground="#B8C8E2"/></Border>
            </DockPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Notification sound" Style="{StaticResource Label}"/><ComboBox IsEnabled="False" Style="{StaticResource SettingCombo}" SelectedIndex="0"><ComboBoxItem Content="Windows default"/><ComboBoxItem Content="Chime"/><ComboBoxItem Content="Asterisk"/><ComboBoxItem Content="No sound"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Playlist notification" Style="{StaticResource Label}"/><ComboBox IsEnabled="False" Style="{StaticResource SettingCombo}" SelectedIndex="0"><ComboBoxItem Content="When the whole playlist finishes"/><ComboBoxItem Content="For every completed video"/></ComboBox></StackPanel>
            </Grid>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False" Margin="0,12,0,0"><StackPanel><TextBlock Text="Notify me when a download fails" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Show a Windows notification when an item cannot be downloaded." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
          </StackPanel>
        </Grid>
      </Border>

      <!-- App behavior -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#263C58" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="#9FC5F8" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <DockPanel LastChildFill="False">
              <StackPanel><TextBlock Text="Application behavior" Style="{StaticResource SectionTitle}"/><TextBlock Text="Control how the download manager starts, closes and stays available." Style="{StaticResource SectionSubtitle}"/></StackPanel>
              <Border Background="#26344D" CornerRadius="8" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="COMING LATER" FontSize="9" FontWeight="Bold" Foreground="#B8C8E2"/></Border>
            </DockPanel>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Start with Windows" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Launch the app automatically when you sign in." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Minimize to system tray" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Keep the app running near the Windows clock when minimized or closed." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Confirm before exiting during active downloads" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Prevent accidentally closing the app while downloads are running." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Check for application updates automatically" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Let the app notify you when a newer version is available." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Scheduling and maintenance -->
      <Border Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#24443F" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" Foreground="#85D9C5" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <DockPanel LastChildFill="False">
              <StackPanel><TextBlock Text="Scheduling &amp; maintenance" Style="{StaticResource SectionTitle}"/><TextBlock Text="Automate downloads and keep the app's history tidy." Style="{StaticResource SectionSubtitle}"/></StackPanel>
              <Border Background="#26344D" CornerRadius="8" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="COMING LATER" FontSize="9" FontWeight="Bold" Foreground="#B8C8E2"/></Border>
            </DockPanel>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Schedule download speed limits" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Use different bandwidth limits at selected times of day." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Shut down Windows when all downloads finish" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Power off the computer after the queue is fully completed." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <CheckBox Style="{StaticResource SettingToggle}" IsEnabled="False"><StackPanel><TextBlock Text="Monitor clipboard for YouTube links" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Offer to add a copied YouTube link to the download queue." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Keep download history for" Style="{StaticResource Label}"/><ComboBox IsEnabled="False" Style="{StaticResource SettingCombo}" SelectedIndex="2"><ComboBoxItem Content="Forever"/><ComboBoxItem Content="30 days"/><ComboBoxItem Content="90 days"/><ComboBoxItem Content="1 year"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Appearance" Style="{StaticResource Label}"/><ComboBox IsEnabled="False" Style="{StaticResource SettingCombo}" SelectedIndex="0"><ComboBoxItem Content="Dark blue"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="System default"/></ComboBox></StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Media tools -->
      <Border Style="{StaticResource SectionCard}" Margin="0,0,0,4">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="#183B4D" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" Foreground="#75D8F5" FontSize="19"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{DynamicResource S.Conversion}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{DynamicResource S.FfmpegAuto}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}"/>
            <Border Background="#0B1630" CornerRadius="9" Padding="12" Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Success}" FontSize="16" Margin="0,0,9,0"/>
                <TextBlock Text="Media tools are managed by the application." FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
