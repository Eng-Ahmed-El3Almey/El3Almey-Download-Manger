<UserControl x:Class="El3Almey.Wpf.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight">
  <UserControl.Resources>
    <Style x:Key="ShortcutCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="ShortcutTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1040" Margin="0,0,12,10">
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Keyboard Shortcuts" FontSize="29" FontWeight="Bold"/>
          <TextBlock Text="A quick reference for controlling downloads and navigating the app."
                     FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#142B50" BorderBrush="#244B83" BorderThickness="1"
                CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Foreground="#68A8FF" FontSize="18" Margin="0,0,9,0"/>
            <TextBlock Text="SHORTCUT GUIDE" Foreground="#B9D5FF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource ShortcutCard}">
            <StackPanel>
              <TextBlock Text="Navigation" Style="{StaticResource ShortcutTitle}"/>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Add Video" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + 1" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Downloads" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + 2" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="History" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + 3" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Settings" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + 4" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Keyboard Shortcuts" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + 5 / F1" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Next / previous page" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + Tab / Ctrl + Shift + Tab" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource ShortcutCard}">
            <StackPanel>
              <TextBlock Text="Download controls" Style="{StaticResource ShortcutTitle}"/>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Pause all downloads" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + P" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Resume all downloads" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + R" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Refresh current list" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="F5" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource ShortcutCard}">
            <StackPanel>
              <TextBlock Text="Selection and files" Style="{StaticResource ShortcutTitle}"/>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Select all" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + A" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Clear selection" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + Shift + A" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Remove selected from list" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Delete" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Delete selected files" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + Delete" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Open selected folder" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + O" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Copy selected URL" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + C" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource ShortcutCard}">
            <StackPanel>
              <TextBlock Text="Add Video" Style="{StaticResource ShortcutTitle}"/>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Focus video URL" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + L" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Fetch link / open selected file" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Enter" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Start download" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + Enter" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Change selected quality" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + ↑ / ↓" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource ShortcutCard}">
            <StackPanel>
              <TextBlock Text="Search and settings" Style="{StaticResource ShortcutTitle}"/>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Search downloads" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + F" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Save settings" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Ctrl + S" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Clear search / cancel entry" Foreground="{StaticResource TextMain}"/><TextBlock Grid.Column="1" Text="Esc" Foreground="#8FC1FF" FontWeight="SemiBold"/></Grid>
            </StackPanel>
          </Border>

          <Border Background="#10294B" BorderBrush="#244B83" BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="20" Foreground="#80B7FF" Margin="0,0,12,0"/>
              <StackPanel>
                <TextBlock Text="Tip" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Press F1 from anywhere in the app to open this shortcuts guide."
                           TextWrapping="Wrap" FontSize="12" Foreground="#B9D5FF" Margin="0,4,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>