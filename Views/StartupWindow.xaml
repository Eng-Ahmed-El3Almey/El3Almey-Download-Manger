<Window x:Class="El3Almey.Wpf.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El3Almey Download Manager"
        Width="620" Height="410"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Loaded="StartupWindow_Loaded"
        Closing="StartupWindow_Closing">
    <Border Background="#0A1225" BorderBrush="#263A60" BorderThickness="1" CornerRadius="16">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="12" Background="#1F7BFF">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="El3Almey Download Manager" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Text="Startup verification" Foreground="#8DA0C3" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="×" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="ExitButton_Click" Background="#14243F" Foreground="#EAF0FB"
                        BorderBrush="#263A60" BorderThickness="1" FontSize="19" Cursor="Hand"/>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="8,20">
                <TextBlock x:Name="HeadingText" Text="Checking required components"
                           FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="DescriptionText"
                           Text="Please wait while the application verifies its required tools."
                           Foreground="#9AABCA" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="490" Margin="0,0,0,24"/>

                <Border Background="#0E1A35" BorderBrush="#1C2F55" BorderThickness="1"
                        CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Checking FFmpeg and yt-dlp..."
                                   Foreground="#EAF0FB" FontSize="13" Margin="0,0,0,12"/>
                        <ProgressBar x:Name="StartupProgressBar" Height="8" Minimum="0" Maximum="100"
                                     IsIndeterminate="True" Value="0"/>
                        <TextBlock x:Name="PercentText" Text=" " Foreground="#8DA0C3"
                                   FontSize="11" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="MissingToolsText" Visibility="Collapsed"
                           Foreground="#FFCF75" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock x:Name="ErrorText" Visibility="Collapsed"
                           Foreground="#FF7A86" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="InstallButton" Content="Download missing tools" Width="220" Height="44"
                        Click="InstallButton_Click" Visibility="Collapsed"
                        Background="#1F7BFF" Foreground="White" BorderBrush="#3479D8"
                        BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0"/>
                <Button x:Name="RetryButton" Content="Retry verification" Width="170" Height="44"
                        Click="RetryButton_Click" Visibility="Collapsed"
                        Background="#192A49" Foreground="#EAF0FB" BorderBrush="#31476D"
                        BorderThickness="1" Cursor="Hand" Margin="0,0,10,0"/>
                <Button x:Name="ExitActionButton" Content="Exit" Width="100" Height="44"
                        Click="ExitButton_Click" Visibility="Visible"
                        Background="#192A49" Foreground="#EAF0FB" BorderBrush="#31476D"
                        BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>