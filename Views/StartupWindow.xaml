<Window x:Class="El3Almey.Wpf.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El3Almey Download Manager" Icon="{StaticResource AppIcon}" Width="980" Height="560"
        MinWidth="900" MinHeight="520" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True"
        Loaded="StartupWindow_Loaded" Closing="StartupWindow_Closing">
    <Window.Resources>
        <Style x:Key="StartupActionButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EAF0FB"/>
            <Setter Property="Background" Value="#172A4B"/>
            <Setter Property="BorderBrush" Value="#2B426A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#234675"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#3D79C8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#17345B"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#77B7FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StartupPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StartupActionButton}">
            <Setter Property="Background" Value="#1F7BFF"/>
            <Setter Property="BorderBrush" Value="#3488FF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Border Background="#080F20" BorderBrush="#29436D" BorderThickness="1"
            CornerRadius="20" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="104"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="94"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0B1730" CornerRadius="19,19,0,0"
                    BorderBrush="#142746" BorderThickness="0,0,0,1">
                <Grid Margin="28,0,22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="14" Background="#1F7BFF">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="El3Almey Download Manager" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText" Text="Startup verification"
                                       Foreground="#91A9CF" FontSize="13" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="×" Style="{StaticResource CloseWindowBtn}" Width="38" Height="38"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="ExitButton_Click"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="28,26,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#0B1934" BorderBrush="#1A3157"
                        BorderThickness="1" CornerRadius="16" Padding="22">
                    <Grid>
                        <Ellipse Width="210" Height="210" Fill="#102B5B" Opacity="0.35"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="156" Height="156" Stroke="#1F7BFF" StrokeThickness="2"
                                 Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="116" Height="104" CornerRadius="15" Background="#102D60"
                                    BorderBrush="#236BCB" BorderThickness="1.5">
                                <Grid>
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="58"
                                               Foreground="#55A5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#1F7BFF"
                                            BorderBrush="#70B6FF" BorderThickness="2"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-17,-13">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="READY TO DOWNLOAD" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#77B7FF" HorizontalAlignment="Center" Margin="0,28,0,0"/>
                            <TextBlock Text="Fast · Simple · Powerful" FontSize="12"
                                       Foreground="#8299BE" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="#1A2C4B" Margin="0,8"/>
                <Grid Grid.Column="2" Margin="34,4,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#102E5A">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="#28A5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="HeadingText" Text="Checking required components"
                                       FontSize="23" FontWeight="SemiBold" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="DescriptionText"
                                   Text="The application checks that every required tool exists and can run before opening."
                                   Foreground="#9AABCA" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,17,0,22" MaxWidth="570"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#0D1B36" BorderBrush="#1D355D"
                            BorderThickness="1" CornerRadius="13" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock x:Name="StatusText" Text="Verifying FFmpeg and yt-dlp..."
                                           Foreground="#EAF0FB" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PercentText" Text="" Foreground="#55A5FF"
                                           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="StartupProgressBar" Height="10" Minimum="0" Maximum="100"
                                         IsIndeterminate="True" Value="0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock x:Name="MissingToolsText" Visibility="Collapsed"
                                   Foreground="#FFCF75" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ErrorText" Visibility="Collapsed"
                                   Foreground="#FF7A86" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Required components: FFmpeg  ·  yt-dlp"
                               Foreground="#657DA4" FontSize="11" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#0A162D" CornerRadius="0,0,19,19"
                    BorderBrush="#142746" BorderThickness="0,1,0,0">
                <Grid Margin="28,0,28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="#39A1FF" VerticalAlignment="Center"/>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="System check" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="This may take a few moments. Please wait..."
                                       Foreground="#91A9CF" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="InstallButton" Content="Download missing tools" Width="205"
                                Style="{StaticResource StartupPrimaryButton}" Click="InstallButton_Click"
                                Visibility="Collapsed" Margin="0,0,10,0"/>
                        <Button x:Name="RetryButton" Content="Retry verification" Width="170"
                                Style="{StaticResource StartupActionButton}" Click="RetryButton_Click"
                                Visibility="Collapsed" Margin="0,0,10,0"/>
                        <Button x:Name="ExitActionButton" Content="Exit" Width="104"
                                Style="{StaticResource StartupActionButton}" Click="ExitButton_Click" Visibility="Visible"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>