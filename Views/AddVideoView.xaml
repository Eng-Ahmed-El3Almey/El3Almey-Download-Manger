<UserControl x:Class="El3Almey.Wpf.Views.AddVideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <Style x:Key="PlaylistOptionSwitch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="#263654" BorderBrush="#526784" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
          </Border>
        </Grid><ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#2D84FF"/><Setter TargetName="Track" Property="BorderBrush" Value="#2D84FF"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#8CC5FF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WhiteSelectionCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid MinHeight="20" Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="#14243F" BorderBrush="#A9BEDB" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock x:Name="CheckMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#2D84FF"/><Setter TargetName="Box" Property="BorderBrush" Value="#65ADFF"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#8CC5FF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PlaylistHeaderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="#D6E5FF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#78B8FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="#A9D4FF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- quality row: radio + label + size + (✓ / ✗) -->
    <DataTemplate x:Key="QualityRow">
      <RadioButton Style="{StaticResource QualityRadio}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
          <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="13" Style="{StaticResource Muted}" Margin="8,0"/>
          <TextBlock Grid.Column="2" FontSize="13" HorizontalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ShowAvailability}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Text" Value="&#xE73E;"/>
                    <Setter Property="Foreground" Value="#2FD27A"/>
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding ShowAvailability}" Value="True"/>
                      <Condition Binding="{Binding IsAvailable}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="&#xE711;"/>
                    <Setter Property="Foreground" Value="#FF5468"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </RadioButton>
    </DataTemplate>

    <!-- playlist entry row -->
    <DataTemplate x:Key="EntryRow">
      <Border x:Name="PlaylistEntryRow" Height="70" BorderThickness="0,0,0,1" BorderBrush="#263957" Background="Transparent">
        <Grid Margin="8,0,24,0" FlowDirection="LeftToRight">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="88"/><ColumnDefinition Width="100"/>
          </Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource WhiteSelectionCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Index}" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border Grid.Column="2" Width="76" Height="44" CornerRadius="6" Background="#1D3358" Margin="0,0,12,0" VerticalAlignment="Center" ClipToBounds="True">
            <Image Source="{Binding Thumb, Mode=OneWay}" Stretch="UniformToFill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Left"/>
            <TextBlock Text="{Binding Channel}" FontSize="12" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextAlignment="Left" Margin="0,3,0,0"/>
          </StackPanel>
          <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="12" Foreground="#C9D6EE" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" Margin="8,0,0,0"/>
          <TextBlock Grid.Column="5" Text="{Binding QualityText}" FontSize="12" Foreground="#8FC2FF" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
          <TextBlock Grid.Column="6" Text="{Binding SizeText}" FontSize="12" Foreground="#9CC2FF" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" Margin="4,0,8,0"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="PlaylistEntryRow" Property="Background" Value="#142B4D"/>
          <Setter TargetName="PlaylistEntryRow" Property="BorderBrush" Value="#315D91"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14">
    <Grid Margin="22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>

      <!-- ===================== main column ===================== -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" IsDeferredScrollingEnabled="False" PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,10,0">

          <TextBlock Text="{DynamicResource S.AddVideo}" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource S.AddSubtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>

          <!-- url row -->
          <Grid Margin="0,20,0,0" Height="54">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource Primary}" BorderThickness="1.5" CornerRadius="10">
              <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="19" Foreground="#9CC2FF"/>
                <TextBox x:Name="UrlBox" Grid.Column="1" PreviewMouseDoubleClick="UrlBox_PreviewMouseDoubleClick" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextMain}" CaretBrush="White" FontSize="14" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource S.PasteHint}" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers><DataTrigger Binding="{Binding Url}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="2" Command="{Binding ClearUrlCommand}" Style="{StaticResource BtnBase}" Background="Transparent" Padding="0" Width="30" Height="30">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13"/></Button>
              </Grid>
            </Border>
            <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Command="{Binding GetVideoCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="17"/>
                <TextBlock Text="{DynamicResource S.GetVideo}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"/>
              </StackPanel>
            </Button>
          </Grid>

          <!-- loading / error -->
          <Border Margin="0,16,0,0" Padding="16,14" Background="#0F2147" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10"
                  Visibility="{Binding IsLoading, Converter={StaticResource B2V}}">
            <StackPanel>
              <ProgressBar Height="4" IsIndeterminate="True" Foreground="#2D84FF" Background="#1B335B" BorderThickness="0" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="16" Foreground="#6AA9FF"/>
              <TextBlock Text="{DynamicResource S.Loading}" FontSize="14" Foreground="#9CC2FF" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Margin="0,16,0,0" Padding="16,14" Background="#431A25" BorderBrush="#7A2A3C" BorderThickness="1" CornerRadius="10"
                  Visibility="{Binding HasError, Converter={StaticResource B2V}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="16" Foreground="#FF5468"/>
              <TextBlock Text="{Binding ErrorText}" FontSize="14" Foreground="#FFB3BE" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- single video card -->
          <Border Margin="0,18,0,0" Padding="14" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12"
                  Visibility="{Binding IsVideoMode, Converter={StaticResource B2V}}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="214" Height="120" CornerRadius="6" Background="#1D3358">
                <Grid>
                  <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Border.Background></Border>
                  <Border Background="#CC000000" CornerRadius="4" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                    <TextBlock Text="{Binding DurationText}" FontSize="12" FontWeight="SemiBold"/></Border>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="20,2,0,0">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="56"/>
                <TextBlock Text="{Binding Channel}" Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Border Background="#E62117" CornerRadius="4" Width="22" Height="16" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="8" Foreground="White"/></Border>
                  <TextBlock Text="YouTube" FontSize="13" Margin="8,0,20,0" Foreground="#C9D6EE"/>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="14" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock Text="{Binding ViewsText}" FontSize="13" Margin="8,0,20,0" Foreground="#C9D6EE"/>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="14" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock Text="{Binding PublishedText}" FontSize="13" Margin="8,0,0,0" Foreground="#C9D6EE"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- playlist card (same screen) -->
          <Border Margin="0,18,0,0" Padding="14" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12"
                  Visibility="{Binding IsPlaylistMode, Converter={StaticResource B2V}}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="150" Height="84" CornerRadius="6" Background="#1D3358">
                  <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Border.Background></Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                  <Border Background="#16336B" CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                    <TextBlock Text="{DynamicResource S.Playlist}" FontSize="11" FontWeight="Bold" Foreground="#9CC2FF"/></Border>
                  <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="52" Margin="0,6,0,0"/>
                  <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0">
                    <Run Text="{Binding Channel, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding PlaylistInfo, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Command="{Binding OnlyThisVideoCommand}" Height="40" VerticalAlignment="Top"
                        Visibility="{Binding HasSingleVideoOption, Converter={StaticResource B2V}}">
                  <TextBlock Text="{DynamicResource S.OnlyThisVideo}" FontSize="13"/>
                </Button>
              </Grid>

              <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,14,0,8"/>
              <!-- The select-all controls, table header, and playlist items occupy separate grid rows. -->
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: selection controls only. -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Style="{StaticResource WhiteSelectionCheckBox}" IsChecked="{Binding AllSelected}" HorizontalAlignment="Left" Margin="10,0,0,0">
                    <TextBlock Text="{DynamicResource S.SelectAll}" FontSize="13"/>
                  </CheckBox>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedCountText}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>

                <!-- Row 1: table column headers only; keep the scrollbar gutter aligned with the ListBox. -->
                <Grid Grid.Row="1" Margin="0,4,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Height="42" Background="#142746" BorderBrush="#2A4165" BorderThickness="1" CornerRadius="7">
                    <Grid Margin="8,0,24,0" FlowDirection="LeftToRight">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="100"/>
                      </Grid.ColumnDefinitions>
                      <Button Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource PlaylistHeaderButton}" Command="{Binding SortByColumnCommand}" CommandParameter="Title"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" FlowDirection="LeftToRight" Padding="0">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" FlowDirection="LeftToRight">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" FlowDirection="LeftToRight">
                            <TextBlock Text="Video title" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left" FlowDirection="LeftToRight" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="{Binding TitleSortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#4A9BFF" Margin="6,0,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Button>
                      <Button Grid.Column="4" Style="{StaticResource PlaylistHeaderButton}" Command="{Binding SortByColumnCommand}" CommandParameter="Duration"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="Duration" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                          <TextBlock Text="{Binding DurationSortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#4A9BFF" Margin="5,0,0,0"/>
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="5" Style="{StaticResource PlaylistHeaderButton}" Command="{Binding SortByColumnCommand}" CommandParameter="SortQualityHeight"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="Quality" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                          <TextBlock Text="{Binding QualitySortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#4A9BFF" Margin="5,0,0,0"/>
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="6" Style="{StaticResource PlaylistHeaderButton}" Command="{Binding SortByColumnCommand}" CommandParameter="SortSizeBytes"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="Est. size" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                          <TextBlock Text="{Binding SizeSortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#4A9BFF" Margin="5,0,0,0"/>
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </Grid>

                <!-- Row 2: playlist entries only. -->
                <ListBox Grid.Row="2" ItemsSource="{Binding EntriesView}" ItemTemplate="{StaticResource EntryRow}" SelectionMode="Multiple" MaxHeight="330"
                         Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="True">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                      <Setter Property="Template">
                        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
              </Grid>
            </StackPanel>
          </Border>

          <!-- download type (no dropdowns) -->
          <TextBlock Text="{DynamicResource S.ChooseType}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <RadioButton Style="{StaticResource TypeCard}" GroupName="type" IsChecked="{Binding IsAudio, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource Primary}">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="23" Foreground="White"/></Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource S.AudioMp3}" FontSize="17" FontWeight="SemiBold" Foreground="#5AA2FF"/>
                  <TextBlock Text="{DynamicResource S.AudioDesc}" Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
              </StackPanel>
            </RadioButton>

            <RadioButton Grid.Column="2" Style="{StaticResource TypeCard}" GroupName="type" IsChecked="{Binding IsVideo, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="26" Background="#1B2B4B">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="23" Foreground="White"/></Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource S.VideoMp4}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource S.VideoDesc}" Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="260"/>
                </StackPanel>
              </StackPanel>
            </RadioButton>
          </Grid>

          <!-- additional options -->
          <Border Margin="0,18,0,0" Padding="20,16" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <TextBlock Text="{DynamicResource S.AddOptions}" FontSize="16" FontWeight="SemiBold"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <CheckBox Style="{StaticResource PlaylistOptionSwitch}" IsChecked="{Binding CreateSubfolder}" IsEnabled="{Binding IsPlaylistMode}" Margin="0,4,0,0">
                    <TextBlock Text="{DynamicResource S.CreateSubfolder}" FontSize="14" TextWrapping="Wrap"/></CheckBox>
                  <CheckBox Style="{StaticResource PlaylistOptionSwitch}" IsChecked="{Binding NumberItems}" IsEnabled="{Binding IsPlaylistMode}" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource S.NumberItems}" FontSize="14" TextWrapping="Wrap"/></CheckBox>
                  <CheckBox Style="{StaticResource PlaylistOptionSwitch}" IsChecked="{Binding CreateM3U}" IsEnabled="{Binding IsPlaylistMode}" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource S.CreateM3U}" FontSize="14" TextWrapping="Wrap"/></CheckBox>
                  <CheckBox Style="{StaticResource PlaylistOptionSwitch}" IsChecked="{Binding IncludeChapters}" IsEnabled="{Binding HasContent}" Margin="0,14,0,0">
                    <TextBlock Text="Embed YouTube chapters" FontSize="14" TextWrapping="Wrap"/>
                  </CheckBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{DynamicResource S.SaveToFolder}" Style="{StaticResource Muted}" FontSize="13"/>
                  <Grid Margin="0,8,0,0" Height="44">
                    <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="17"/>
                      <TextBox Grid.Column="1" Text="{Binding SaveFolder}" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                               Foreground="{StaticResource TextMain}" FontSize="13" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
                      <Button Grid.Column="2" Command="{Binding BrowseCommand}" Style="{StaticResource BtnBase}" Background="#14243F" Padding="0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE712;"/></Button>
                    </Grid>
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0" Padding="16,11" Background="#0F2147" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="15" Foreground="#6AA9FF"/>
              <TextBlock Text="{DynamicResource S.PlaylistHint}" FontSize="13" Foreground="#9CC2FF" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- buttons -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,6">
            <Button Style="{StaticResource GhostBtn}" Content="{DynamicResource S.Cancel}" Width="104" Height="46" Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
            <Button Style="{StaticResource GhostBtn}" Height="46" Padding="20,0" Command="{Binding AddToQueueCommand}" IsEnabled="{Binding CanDownload}" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="15"/>
                <TextBlock Text="{DynamicResource S.AddToQueue}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryBtn}" Height="46" Padding="22,0" Command="{Binding DownloadNowCommand}" IsEnabled="{Binding CanDownload}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="16"/>
                <TextBlock Text="{DynamicResource S.DownloadNow}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel>
            </Button>

          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- ===================== quality preview ===================== -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" IsDeferredScrollingEnabled="False" PanningMode="VerticalOnly">
        <StackPanel>
          <Border Padding="16,16,16,12" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <TextBlock Text="{DynamicResource S.QualityPreview}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <Border Padding="8" Background="#0B1630" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <StackPanel>
                  <!-- video qualities -->
                  <StackPanel>
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{DynamicResource S.VideoQualities}" FontSize="14" FontWeight="SemiBold" Margin="8,6,0,6"/>
                    <ItemsControl ItemsSource="{Binding VideoQualities}" ItemTemplate="{StaticResource QualityRow}"/>
                  </StackPanel>
                  <!-- audio qualities -->
                  <StackPanel>
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsAudio}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{DynamicResource S.AudioQualities}" FontSize="14" FontWeight="SemiBold" Margin="8,6,0,6"/>
                    <ItemsControl ItemsSource="{Binding AudioQualities}" ItemTemplate="{StaticResource QualityRow}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0" Padding="16" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <TextBlock Text="Audio Track" FontSize="14" Foreground="#C9D6EE" Margin="0,0,0,8"/>
              <ComboBox Height="40" Padding="8,4" ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding HasContent}"/>
              <TextBlock Text="Choose the source audio language. Default marks the track YouTube reports as default." FontSize="11" Foreground="#8193B4" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <TextBlock Text="Original Subtitles" FontSize="14" Foreground="#C9D6EE" Margin="0,14,0,8"/>
              <ComboBox Height="40" Padding="8,4" ItemsSource="{Binding OriginalSubtitleTracks}" SelectedItem="{Binding SelectedOriginalSubtitleTrack, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding HasContent}"/>
              <TextBlock Text="Generated Subtitles" FontSize="14" Foreground="#C9D6EE" Margin="0,12,0,8"/>
              <ComboBox Height="40" Padding="8,4" ItemsSource="{Binding AutoTranslatedSubtitleTracks}" SelectedItem="{Binding SelectedAutoTranslatedSubtitleTrack, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding HasContent}"/>
              <TextBlock Text="Subtitle files are saved beside the downloaded video when available." FontSize="11" Foreground="#8193B4" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0" Padding="16" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <TextBlock Text="Output format" FontSize="14" Foreground="#C9D6EE" Margin="0,0,0,8"/>
              <ComboBox Height="40" Padding="8,4" ItemsSource="{Binding VideoFormats}" SelectedItem="{Binding SelectedVideoFormat, Mode=TwoWay}">
                <ComboBox.Style>
                  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsAudio}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                  </Style>
                </ComboBox.Style>
              </ComboBox>
              <ComboBox Height="40" Padding="8,4" ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding SelectedAudioFormat, Mode=TwoWay}">
                <ComboBox.Style>
                  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsAudio}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </ComboBox.Style>
              </ComboBox>
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0" Padding="16" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <TextBlock Text="{DynamicResource S.TotalSize}" FontSize="14" Foreground="#C9D6EE"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Border Width="48" Height="48" CornerRadius="24" Background="#1B2B4B">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xEE94;" FontSize="20" Foreground="#9CC2FF"/></Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TotalSizeText}" FontSize="18" FontWeight="Bold"/>
                  <TextBlock Text="{Binding TotalSizeFor}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="210"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
