<UserControl x:Class="El3Almey.Wpf.Views.AudioPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="4,0,0,18">
      <TextBlock Text="Audio Player" FontSize="26" FontWeight="Bold"/>
      <TextBlock Text="Your music collection and listening space" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="210" Height="210" CornerRadius="22" Background="#142B53">
            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="78" Foreground="#75B5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Nothing playing" FontSize="21" FontWeight="SemiBold" Margin="0,22,0,4" HorizontalAlignment="Center"/>
          <TextBlock Text="Select an audio file to begin" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconBtn}" IsEnabled="False" Margin="5"/>
            <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconBtn}" IsEnabled="False" Margin="5"/>
            <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconBtn}" IsEnabled="False" Margin="5"/>
          </StackPanel>
          <Slider Width="420" Maximum="100" Value="0" IsEnabled="False" Margin="0,20,0,0"/>
          <TextBlock Text="00:00                                      00:00" Foreground="{StaticResource TextMuted}" FontSize="12"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="14,0,0,0">
        <StackPanel>
          <TextBlock Text="Playlists" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Your playlists will appear here." Foreground="{StaticResource TextMuted}" Margin="0,12,0,0"/>
          <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,18"/>
          <TextBlock Text="Recently Played" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="Your recent audio files will appear here." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>