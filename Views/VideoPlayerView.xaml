<UserControl x:Class="El3Almey.Wpf.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="{StaticResource WindowBg}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header and source actions -->
    <Grid Margin="2,0,2,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Video Player" FontSize="27" FontWeight="Bold"/>
        <TextBlock Text="Your video space — local files, downloaded videos and online streams" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="ToggleLibraryButton" Style="{StaticResource GhostBtn}" Height="40" Margin="0,0,8,0" Click="ToggleLibrary_Click" Content="Hide Library"/>
        <Button Style="{StaticResource GhostBtn}" Height="40" Margin="0,0,8,0" Click="OpenUrl_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Open URL"/></StackPanel>
        </Button>
        <Button Style="{StaticResource PrimaryBtn}" Height="40" Click="OpenFile_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="Open Video"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid x:Name="PlayerLayoutGrid" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition x:Name="LibraryColumn" Width="330"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- Main player -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#030711" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
          <Grid>
            <vlc:VideoView x:Name="VideoSurface" Background="#030711" />
            <StackPanel x:Name="EmptyPlayerPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="86" Height="86" CornerRadius="24" Background="#142B53" HorizontalAlignment="Center">
                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="#75B5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Ready when you are" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6"/>
              <TextBlock Text="Open a video from your PC or paste an online video URL." Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button Style="{StaticResource PrimaryBtn}" Height="40" Padding="20,0" Click="OpenFile_Click" Content="Browse Videos"/>
                <Button Style="{StaticResource GhostBtn}" Height="40" Padding="20,0" Margin="10,0,0,0" Click="OpenUrl_Click" Content="Play from URL"/>
              </StackPanel>
            </StackPanel>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16" Background="#B3142440" CornerRadius="6" Padding="10,5">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#37D98A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="VIDEO PLAYER" FontSize="10" FontWeight="Bold" Foreground="#D8E8FF"/>
              </StackPanel>
            </Border>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                    Style="{StaticResource GhostBtn}" Height="34" Padding="12,0"
                    Click="FullScreen_Click" ToolTip="Enter full screen (Esc to exit)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE740;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,7,0"/>
                <TextBlock Text="Full Screen" FontSize="12"/>
              </StackPanel>
            </Button>
            <Border VerticalAlignment="Bottom" Background="#CC080F20" Padding="16,12">
              <StackPanel>
                <TextBlock x:Name="NowPlayingTitle" Text="No video selected" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NowPlayingSource" Text="Choose a local file or online URL to begin" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Playback controls visual design -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,0">
          <StackPanel>
            <Slider x:Name="PositionSlider" Minimum="0" Maximum="1000" Value="0" Height="16" IsEnabled="False" ValueChanged="PositionSlider_ValueChanged" PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp"/>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" Width="76" Height="36" Margin="4,0" Content="−10 sec" FontFamily="Segoe UI" FontWeight="SemiBold" Click="Back10_Click" ToolTip="Back 10 seconds"/>
                <Button x:Name="PlayPauseButton" Style="{StaticResource IconBtn}" Width="76" Height="40" Margin="4,0" Content="Play" FontFamily="Segoe UI" FontWeight="SemiBold" Click="PlayPause_Click" ToolTip="Play / Pause"/>
                <Button Style="{StaticResource IconBtn}" Width="76" Height="36" Margin="4,0" Content="+10 sec" FontFamily="Segoe UI" FontWeight="SemiBold" Click="Forward10_Click" ToolTip="Forward 10 seconds"/>
              </StackPanel>
              <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostBtn}" Height="30" Padding="10,0" Margin="0,0,7,0" Click="OpenSubtitle_Click" Content="Load Subtitle"/>
                <Button Style="{StaticResource GhostBtn}" Height="30" Padding="10,0" IsEnabled="False" Content="Audio Track"/>
                <Button Style="{StaticResource GhostBtn}" Height="30" Padding="12,0" Margin="6,0,0,0" Click="FullScreen_Click" Content="Full Screen"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="SpeedCombo" Width="76" Height="28" SelectedIndex="2" SelectionChanged="SpeedCombo_SelectionChanged" Margin="0,0,12,0"><ComboBoxItem Content="0.5x"/><ComboBoxItem Content="0.75x"/><ComboBoxItem Content="1.0x"/><ComboBoxItem Content="1.25x"/><ComboBoxItem Content="1.5x"/><ComboBoxItem Content="2.0x"/></ComboBox>
                <TextBlock Text="Volume" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="VolumeSlider" Width="118" Height="24" Minimum="0" Maximum="100" Value="80" Foreground="{StaticResource Primary}" Background="{StaticResource CardBorder}" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" ToolTip="Volume"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Library / queue panel -->
      <Border x:Name="LibraryPanel" Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="14,0,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Your Library" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Local + online sources" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="34" Height="34" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Click="AddFolder_Click" ToolTip="Add library folder"/>
          </Grid>
          <TextBox x:Name="LibrarySearchBox" Grid.Row="1" Height="34" Margin="0,14,0,10"
                   TextChanged="LibrarySearchBox_TextChanged"
                   Background="{StaticResource InputBg}" Foreground="{StaticResource TextMain}"
                   BorderBrush="{StaticResource CardBorder}" Padding="9,6"
                   ToolTip="Search your video library"/>
          <ListBox x:Name="LibraryList" Grid.Row="2" Margin="0,0,0,0"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   MouseDoubleClick="LibraryList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="Background" Value="{StaticResource InputBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
          <Button Style="{StaticResource GhostBtn}" Height="34" Margin="0,0,0,7" Click="RefreshLibrary_Click" Content="Refresh Library"/>
          <Button Style="{StaticResource GhostBtn}" Height="38" Click="AddFolder_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Library Folder"/></StackPanel>
          </Button>
        </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>