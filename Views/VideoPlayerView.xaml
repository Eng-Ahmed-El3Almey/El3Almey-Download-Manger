<UserControl x:Class="El3Almey.Wpf.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="4,0,0,18">
      <TextBlock Text="Video Player" FontSize="26" FontWeight="Bold"/>
      <TextBlock Text="Your local video library and playback workspace" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Border Background="#050A14" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="18">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="82" Height="82" CornerRadius="22" Background="#142B53" HorizontalAlignment="Center">
              <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#75B5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Choose a video to start watching" FontSize="19" FontWeight="SemiBold" Margin="0,20,0,6" HorizontalAlignment="Center"/>
            <TextBlock Text="Playback controls and your video library will appear here." Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
            <Button Content="Open Video" Style="{StaticResource PrimaryBtn}" Height="42" Margin="0,22,0,0" Padding="24,0" IsEnabled="False"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8">
            <TextBlock Text="00:00" Foreground="#C7D7F1"/>
            <Slider Minimum="0" Maximum="100" Value="0" IsEnabled="False" Margin="14,0" VerticalAlignment="Center"/>
            <TextBlock Text="00:00" Foreground="#C7D7F1"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="14,0,0,0">
        <StackPanel>
          <TextBlock Text="Up Next" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Your playlist is empty" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0"/>
          <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,18"/>
          <TextBlock Text="Recently Played" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="Recently opened videos will appear here." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>