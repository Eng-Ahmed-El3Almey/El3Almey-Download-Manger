<UserControl x:Class="El3Almey.Wpf.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBg}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header and source actions -->
    <Grid Margin="2,0,2,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Video Player" FontSize="27" FontWeight="Bold"/>
        <TextBlock Text="Your video space — local files, downloaded videos and online streams" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource GhostBtn}" Height="40" Margin="0,0,8,0" Click="OpenUrl_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Open URL"/></StackPanel>
        </Button>
        <Button Style="{StaticResource PrimaryBtn}" Height="40" Click="OpenFile_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="Open Video"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- Main player -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#030711" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
          <Grid>
            <StackPanel x:Name="EmptyPlayerPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="86" Height="86" CornerRadius="24" Background="#142B53" HorizontalAlignment="Center">
                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="#75B5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Ready when you are" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6"/>
              <TextBlock Text="Open a video from your PC or paste an online video URL." Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button Style="{StaticResource PrimaryBtn}" Height="40" Padding="20,0" Click="OpenFile_Click" Content="Browse Videos"/>
                <Button Style="{StaticResource GhostBtn}" Height="40" Padding="20,0" Margin="10,0,0,0" Click="OpenUrl_Click" Content="Play from URL"/>
              </StackPanel>
            </StackPanel>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16" Background="#B3142440" CornerRadius="6" Padding="10,5">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#37D98A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="PLAYER READY" FontSize="10" FontWeight="Bold" Foreground="#D8E8FF"/>
              </StackPanel>
            </Border>
            <Border VerticalAlignment="Bottom" Background="#CC080F20" Padding="16,12">
              <StackPanel>
                <TextBlock x:Name="NowPlayingTitle" Text="No video selected" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NowPlayingSource" Text="Choose a local file or online URL to begin" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Playback controls visual design -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,0">
          <StackPanel>
            <Slider Minimum="0" Maximum="100" Value="0" IsEnabled="False" Height="16"/>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="00:00" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" Width="36" Height="34" Margin="3,0" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" IsEnabled="False" ToolTip="Previous"/>
                <Button Style="{StaticResource IconBtn}" Width="42" Height="38" Margin="3,0" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" IsEnabled="False" ToolTip="Play / Pause"/>
                <Button Style="{StaticResource IconBtn}" Width="36" Height="34" Margin="3,0" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" IsEnabled="False" ToolTip="Next"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="00:00" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostBtn}" Height="30" Padding="10,0" Margin="0,0,7,0" IsEnabled="False" Content="Subtitles"/>
                <Button Style="{StaticResource GhostBtn}" Height="30" Padding="10,0" IsEnabled="False" Content="Audio Track"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="1.0x" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" Foreground="{StaticResource TextMuted}" Margin="0,0,7,0"/>
                <TextBlock Text="Volume" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Library / queue panel -->
      <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="14,0,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Your Library" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Local + online sources" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="34" Height="34" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Click="AddFolder_Click" ToolTip="Add library folder"/>
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <Border Background="{StaticResource SelectedBg}" CornerRadius="7" Padding="10,6" Margin="0,0,6,0"><TextBlock Text="All Videos" FontSize="11" FontWeight="SemiBold"/></Border>
            <Border Background="{StaticResource InputBg}" CornerRadius="7" Padding="10,6" Margin="0,0,6,0"><TextBlock Text="Continue" FontSize="11" Foreground="{StaticResource TextMuted}"/></Border>
            <Border Background="{StaticResource InputBg}" CornerRadius="7" Padding="10,6"><TextBlock Text="Favorites" FontSize="11" Foreground="{StaticResource TextMuted}"/></Border>
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LibraryItems">
              <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,9">
                <StackPanel>
                  <TextBlock Text="Downloaded Videos" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="Videos saved by El3Almey Download Manager" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <TextBlock Text="Automatic download sync — next stage" FontSize="10" Foreground="#70B6FF" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                  <TextBlock Text="My Folders" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock x:Name="FolderSummary" Text="No custom folders added yet" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="#101F3D" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="Recently Played" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="Your viewing history will appear here." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Button Grid.Row="3" Style="{StaticResource GhostBtn}" Height="38" Margin="0,12,0,0" Click="AddFolder_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add Library Folder"/></StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>