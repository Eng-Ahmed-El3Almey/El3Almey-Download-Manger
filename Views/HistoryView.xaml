<UserControl x:Class="El3Almey.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseDown="UserControl_PreviewMouseDown">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <TextBlock Text="{DynamicResource S.History}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ComboBox Width="125" Height="42" Margin="0,0,12,0" Padding="10,0" VerticalContentAlignment="Center"
                  Background="{StaticResource InputBg}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource CardBorder}"
                  ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>
        <Border Width="300" Height="42" Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0">
          <Grid Margin="12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="15" Foreground="{StaticResource TextMuted}"/>
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextMain}" CaretBrush="White" FontSize="14" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource S.SearchHistory}" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
        <Button Style="{StaticResource GhostBtn}" Command="{Binding ClearAllCommand}" Height="42" Padding="18,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15"/>
            <TextBlock Text="{DynamicResource S.ClearHistory}" FontSize="14" Margin="10,0,0,0"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
          <Grid Margin="20,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="190"/><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource S.ColVideo}" FontSize="14" FontWeight="SemiBold" Foreground="#C9D6EE" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource S.ColStatus}" FontSize="14" FontWeight="SemiBold" Foreground="#C9D6EE" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource S.ColDate}" FontSize="14" FontWeight="SemiBold" Foreground="#C9D6EE" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource S.ColSize}" FontSize="14" FontWeight="SemiBold" Foreground="#C9D6EE" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="{DynamicResource S.ColActions}" FontSize="14" FontWeight="SemiBold" Foreground="#C9D6EE" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="{DynamicResource S.NoHistory}" Style="{StaticResource Muted}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="HistoryRow" Height="72" BorderThickness="0,0,0,1" BorderBrush="#263957" PreviewMouseRightButtonDown="HistoryRow_PreviewMouseRightButtonDown" MouseLeftButtonDown="HistoryRow_MouseLeftButtonDown">
                  <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#263957"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3155"/><Setter Property="BorderBrush" Value="#4A9BFF"/></Trigger></Style.Triggers></Style></Border.Style>
                  <Grid Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="190"/><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="76" Height="44" CornerRadius="6" Background="#1D3358">
                        <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background></Border>
                      </Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                        <TextBlock Text="{Binding DisplayDetails}" FontSize="12" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                      </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{Binding StatusBg}" CornerRadius="6" Padding="12,5" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding Error}">
                      <TextBlock Text="{Binding DisplayStatusText}" Foreground="{Binding DisplayStatusFg}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding DateText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="13" Foreground="#C9D6EE" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding HistorySizeText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="13" Foreground="#C9D6EE" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource IconBtn}" Margin="0,0,8,0" ToolTip="View playlist contents" ToolTipService.Placement="Bottom"
                              Visibility="{Binding CanOpenPlaylist, Converter={StaticResource B2V}}"
                              Command="{Binding DataContext.OpenPlaylistDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="16"/></Button>
                      <Button Style="{StaticResource IconBtn}" Margin="0,0,8,0" ToolTip="Play downloaded file" ToolTipService.Placement="Bottom" Visibility="{Binding IsCompleted, Converter={StaticResource B2V}}"
                              Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="15"/></Button>
                      <Button Style="{StaticResource IconBtn}" Margin="0,0,8,0" ToolTip="Open download location" ToolTipService.Placement="Bottom" Visibility="{Binding CanOpenFolder, Converter={StaticResource B2V}}"
                              Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15"/></Button>
                      <Button Style="{StaticResource IconBtn}" Margin="0,0,8,0" ToolTip="Download again" ToolTipService.Placement="Bottom"
                              Command="{Binding DataContext.RedownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="15"/></Button>
                      <Button Style="{StaticResource IconBtn}" ToolTip="Remove from history (keeps file)" ToolTipService.Placement="Bottom"
                              Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15" Foreground="{StaticResource Danger}"/></Button>
                      <ToggleButton x:Name="HistoryMoreBtn" IsChecked="{Binding IsMenuOpen, Mode=TwoWay}" Click="HistoryMoreBtn_Click" Width="38" Height="38" Cursor="Hand" ToolTip="More actions" Margin="0,0,0,0">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="HistoryMoreBorder" Background="#14243F" BorderBrush="#263D61" BorderThickness="1" CornerRadius="8"><TextBlock Style="{StaticResource Icon}" Text="⋮" FontFamily="Segoe UI Symbol" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryMoreBorder" Property="Background" Value="#234675"/><Setter TargetName="HistoryMoreBorder" Property="BorderBrush" Value="#4A9BFF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="HistoryMoreBorder" Property="Background" Value="#1D3D68"/><Setter TargetName="HistoryMoreBorder" Property="BorderBrush" Value="#4A9BFF"/></Trigger></ControlTemplate.Triggers>
                          </ControlTemplate>
                        </ToggleButton.Template>
                      </ToggleButton>
                      <Popup x:Name="HistoryActionPopup" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" IsOpen="{Binding IsMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=HistoryMoreBtn}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                        <Border Width="214" Padding="6" Background="#0F1B38" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10">
                          <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
                          <StackPanel>
                            <Button Style="{StaticResource MenuItemBtn}" Click="ActionMenuItem_Click" Tag="Open"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Width="26"/><TextBlock Text="Play / Open file"/></StackPanel></Button>
                            <Button Style="{StaticResource MenuItemBtn}" Click="ActionMenuItem_Click" Tag="OpenFolder"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Width="26"/><TextBlock Text="Open download folder"/></StackPanel></Button>
                            <Button Style="{StaticResource MenuItemBtn}" Click="ActionMenuItem_Click" Tag="Redownload"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Width="26"/><TextBlock Text="Download again"/></StackPanel></Button>
                            <Button Style="{StaticResource MenuItemBtn}" Click="ActionMenuItem_Click" Tag="Remove"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Width="26" Foreground="{StaticResource Danger}"/><TextBlock Text="Remove from history" Foreground="{StaticResource Danger}"/></StackPanel></Button>
                          </StackPanel>
                        </Border>
                      </Popup>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding CountText}" Style="{StaticResource Muted}" FontSize="13" Margin="0,14,0,0"/>


    <!-- Playlist detail panel: matches the playlist detail view in Downloads. -->
    <Grid Grid.RowSpan="3" Panel.ZIndex="10" Visibility="{Binding IsPlaylistDetailOpen, Converter={StaticResource B2V}}" Background="{StaticResource WindowBg}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
        <Button Style="{StaticResource GhostBtn}" Height="42" Width="112" Command="{Binding BackFromPlaylistCommand}">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" Margin="0,0,8,0"/><TextBlock Text="Back"/></StackPanel>
        </Button>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding PlaylistDetailTitle}" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding PlaylistDetailSummary}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>
      </StackPanel>
      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="Playlist videos" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="3" Text="Date" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="4" Text="Size" FontWeight="SemiBold"/>
      </Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding PlaylistItems}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Height="72" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                <Border Width="64" Height="42" CornerRadius="5" Background="#1D3358" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True">
                  <Image Source="{Binding Thumbnail, Mode=OneWay}" Stretch="UniformToFill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding PlaylistIndex}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                  <TextBlock Text="{Binding PlaylistVideoDisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{Binding StatusBg}" CornerRadius="6" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding DateText}" Foreground="#C9D6EE" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding TotalSizeText}" Foreground="#C9D6EE" FontSize="12" VerticalAlignment="Center"/>
                <Button Grid.Column="5" Style="{StaticResource IconBtn}" Width="38" Height="34" Padding="0" VerticalAlignment="Center"
                        ToolTip="Open downloaded video or retry failed video"
                        Command="{Binding DataContext.PlaylistItemActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                  <TextBlock Style="{StaticResource Icon}" Text="{Binding PrimaryIcon}"/>
                </Button>
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
