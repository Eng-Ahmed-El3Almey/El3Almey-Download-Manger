<Window x:Class="El3Almey.Wpf.Views.DuplicateFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Existing download" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0B1428" Foreground="#EAF1FF" FontFamily="Segoe UI" FontSize="14">
  <Border Margin="1" Padding="24" Background="#0F1B38" BorderBrush="#263A60" BorderThickness="1" CornerRadius="14">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
        <Border Width="46" Height="46" CornerRadius="12" Background="#19345E">
          <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#76B0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="HeadingText" Text="Video already exists" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubheadingText" Text="Choose what you want to do" Foreground="#9AABCA" Margin="0,4,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border Background="#111F3D" BorderBrush="#263A60" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,18">
        <TextBlock x:Name="VideoTitleText" TextWrapping="Wrap" FontWeight="SemiBold"/>
      </Border>
      <Button x:Name="NewNameButton" Height="46" Click="NewNameButton_Click" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,10">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Background" Value="#2468C9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3479D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            
            
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2D74D8"/>
                
                
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1765D1"/></Trigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
          <TextBlock x:Name="NewNameButtonText" Text="Download with a new name"/>
        </StackPanel>
      </Button>
      <Button x:Name="SkipButton" Height="44" Click="SkipButton_Click" Cursor="Hand" Margin="0,0,0,10">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Background" Value="#192A49"/>
            <Setter Property="Foreground" Value="#EAF1FF"/>
            <Setter Property="BorderBrush" Value="#31476D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#213758"/>
                <Setter Property="BorderBrush" Value="#5A91D8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#12203A"/></Trigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
          <TextBlock x:Name="SkipButtonText" Text="Skip this video"/>
        </StackPanel>
      </Button>
      <Button x:Name="CancelButton" Height="40" Click="CancelButton_Click" Cursor="Hand">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AABCA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#1B2D4D"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="#76B0FF"/></Trigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <TextBlock x:Name="CancelButtonText" Text="Cancel"/>
      </Button>
    </StackPanel>
  </Border>
</Window>
