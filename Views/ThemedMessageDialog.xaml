<Window x:Class="El3Almey.Wpf.Views.ThemedMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="#0F1B32" BorderBrush="#345078" BorderThickness="1" CornerRadius="13" Padding="22">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="IconSurface" Width="40" Height="40" CornerRadius="12" Background="#19365C" VerticalAlignment="Center">
                    <TextBlock x:Name="IconText" Text="i" Foreground="#66B1FF" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="DialogTitle" Text="Information" Foreground="#F4F7FC" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="EL3ALMEY DOWNLOAD MANAGER" Foreground="#7895BC" FontSize="9" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="DialogMessage" Grid.Row="1" Foreground="#C7D5E9" FontSize="13"
                       TextWrapping="Wrap" LineHeight="20" Margin="0,19,0,8"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="NoButton" Content="No" MinWidth="92" Padding="15,9" Margin="0,0,9,0"
                        Background="#172A46" Foreground="#DCE8F8" BorderBrush="#355276" BorderThickness="1"
                        FontWeight="SemiBold" Cursor="Hand" Click="No_Click" Visibility="Collapsed"/>
                <Button x:Name="YesButton" Content="Yes" MinWidth="92" Padding="15,9" Background="#1F65B8" Foreground="White"
                        BorderBrush="#2B8CFF" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="Yes_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>