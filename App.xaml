<Application x:Class="El3Almey.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>\n    <DrawingImage x:Key="AppIcon">\n      <DrawingImage.Drawing>\n        <DrawingGroup>\n          <GeometryDrawing Brush="#1F7BFF" Geometry="M0,0 H64 V64 H0 Z"/>\n          <GeometryDrawing Brush="#FFFFFF" Geometry="M27,10 L27,37 L17,27 L12,32 L30,50 L48,32 L43,27 L33,37 L33,10 Z"/>\n        </DrawingGroup>\n      </DrawingImage.Drawing>\n    </DrawingImage>

    <!-- ===== Colors ===== -->
    <SolidColorBrush x:Key="WindowBg" Color="#0A1225"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#0B1530"/>
    <SolidColorBrush x:Key="CardBg" Color="#0E1A35"/>
    <SolidColorBrush x:Key="InputBg" Color="#0B1630"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1C2F55"/>
    <SolidColorBrush x:Key="SelectedBg" Color="#16336B"/>
    <SolidColorBrush x:Key="SelectedCardBg" Color="#10285A"/>
    <SolidColorBrush x:Key="Primary" Color="#1F7BFF"/>
    <SolidColorBrush x:Key="TextMain" Color="#EAF0FB"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8DA0C3"/>
    <SolidColorBrush x:Key="Danger" Color="#FF4D5E"/>
    <SolidColorBrush x:Key="Success" Color="#2FD27A"/>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#172A4D"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#4A9BFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MaxWidth" Value="320"/>
      <Setter Property="Placement" Value="Bottom"/>
      <Setter Property="VerticalOffset" Value="6"/>
    </Style>
    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
      <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#234675"/>
                <Setter TargetName="b" Property="Opacity" Value="1"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#4A9BFF"/>
                <Setter TargetName="b" Property="BorderThickness" Value="1.5"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#77B7FF"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="{StaticResource Primary}"/>
    </Style>
    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="{StaticResource InputBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#14243F"/>
      <Setter Property="BorderBrush" Value="#263D61"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="MenuItemBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#234675"/><Setter TargetName="b" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#2D5A91"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Sidebar item ===== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="16,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#101F3F"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SelectedBg}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="46"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="16,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#101F3F"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Filter chip ===== -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="#101D3B" CornerRadius="18" Padding="18,8" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Primary}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Primary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== CheckBox ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel x:Name="root" Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="20" Height="20" CornerRadius="4" BorderThickness="1.5" BorderBrush="#3A4F7A" Background="Transparent">
                <TextBlock x:Name="tick" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="White" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Primary}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Primary}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Radio rows (quality list) ===== -->
    <Style x:Key="QualityRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="10,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="20" Height="20" HorizontalAlignment="Left">
                  <Ellipse x:Name="ring" Stroke="#5A6F98" StrokeThickness="1.5"/>
                  <Ellipse x:Name="dot" Width="10" Height="10" Fill="{StaticResource Primary}" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="row" Property="Background" Value="#12306A"/>
                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Primary}"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="#5AA2FF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="row" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Selectable type card ===== -->
    <Style x:Key="TypeCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="card" Background="#0C1830" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" CornerRadius="12" Padding="20">
              <Grid>
                <ContentPresenter/>
                <Border x:Name="chk" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Primary}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Visibility="Collapsed">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="White"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Primary}"/>
                <Setter TargetName="card" Property="Background" Value="{StaticResource SelectedCardBg}"/>
                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== ProgressBar ===== -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource Primary}"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#1A2A4A" CornerRadius="3"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Padding="14,9" Background="Transparent" CornerRadius="6">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#16284A"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#12306A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="tb" ClickMode="Press" Cursor="Hand"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Grid IsHitTestVisible="False" Margin="14,0">
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12" HorizontalAlignment="Right"/>
              </Grid>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                <Border MinWidth="{Binding ActualWidth, ElementName=tb}" MaxHeight="260" Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="4">
                  <ScrollViewer><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Scrollbar (thin) ===== -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Border Background="#243A66" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
